<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="opencode-dotnet" value="https://nuget.pkg.github.com/opencode-dotnet/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="opencode-dotnet">
      <package pattern="OpenCodeDotNet.Mcp" />
      <package pattern="OpenCodeDotNet.Mcp.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
